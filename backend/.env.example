# SmartStock AI backend environment configuration.
# Copy this file to `.env` and adjust values. Never commit real secrets.

# --- Application ---
APP_NAME=SmartStock AI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL connection string for the application.
DATABASE_URL=postgresql+psycopg2://smartstock:smartstock@localhost:5432/smartstock
# Separate database used by PostgreSQL integration tests.
TEST_DATABASE_URL=postgresql+psycopg2://smartstock:smartstock@localhost:5432/smartstock_test

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins, or * for all.
CORS_ORIGINS=*
